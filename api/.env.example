# Copy this file to .env and fill it in. Never commit .env to GitHub.

# Supabase: Connect button > connection string (put your database password in it)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Password for the owner view
OWNER_PASSWORD=change-this

PORT=3000
